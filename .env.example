# Port to run the server on
PORT=5000

# MongoDB Connection URI (fallback is mongodb://localhost:27017/sopl)
MONGO_URI=mongodb://localhost:27017/sopl

# JWT Secret Key for token signing
JWT_SECRET=secret_key_change_this

# Telegram notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AWS S3 Storage Config (Optional, falls back to local storage if not defined)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
